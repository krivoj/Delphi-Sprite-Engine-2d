<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <ProjectGuid>{6C915F55-0F2A-4BBF-B5FE-B0C3D98B3892}</ProjectGuid>
    </PropertyGroup>
    <ItemGroup>
        <Projects Include="SpriteEngine.dproj">
            <Dependencies/>
        </Projects>
        <Projects Include="SpriteEngine.Controls.dproj">
            <Dependencies/>
        </Projects>
    </ItemGroup>
    <ProjectExtensions>
        <Borland.Personality>Default.Personality.12</Borland.Personality>
        <Borland.ProjectType/>
        <BorlandProject>
            <Default.Personality/>
        </BorlandProject>
    </ProjectExtensions>
    <Target Name="SpriteEngine">
        <MSBuild Projects="SpriteEngine.dproj"/>
    </Target>
    <Target Name="SpriteEngine:Clean">
        <MSBuild Projects="SpriteEngine.dproj" Targets="Clean"/>
    </Target>
    <Target Name="SpriteEngine:Make">
        <MSBuild Projects="SpriteEngine.dproj" Targets="Make"/>
    </Target>
    <Target Name="SpriteEngine_Controls">
        <MSBuild Projects="SpriteEngine.Controls.dproj"/>
    </Target>
    <Target Name="SpriteEngine_Controls:Clean">
        <MSBuild Projects="SpriteEngine.Controls.dproj" Targets="Clean"/>
    </Target>
    <Target Name="SpriteEngine_Controls:Make">
        <MSBuild Projects="SpriteEngine.Controls.dproj" Targets="Make"/>
    </Target>
    <Target Name="Build">
        <CallTarget Targets="SpriteEngine;SpriteEngine_Controls"/>
    </Target>
    <Target Name="Clean">
        <CallTarget Targets="SpriteEngine:Clean;SpriteEngine_Controls:Clean"/>
    </Target>
    <Target Name="Make">
        <CallTarget Targets="SpriteEngine:Make;SpriteEngine_Controls:Make"/>
    </Target>
    <Import Project="$(BDS)\Bin\CodeGear.Group.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Group.Targets')"/>
</Project>
